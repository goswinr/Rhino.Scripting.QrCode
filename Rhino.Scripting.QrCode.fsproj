<?xml version="1.0" encoding="utf-8"?>
<!--https://docs.microsoft.com/en-us/dotnet/core/project-sdk/msbuild-props-->
<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net48</TargetFramework> <!-- so it can be used in latest Rhino 7 too,  net48 needed since RhinoCommon.dll 7.5 --> 
    <UseWPF>true</UseWPF><!--for DispatcherSynchronizationContext in SyncRhino, and Seff editor Window (if available)-->
    <UseWindowsForms>true</UseWindowsForms>   <!--to get screen resolution-->
    <LangVersion>preview</LangVersion>
    <OtherFlags>$(OtherFlags)--warnon:3390</OtherFlags>  <!-- warnon:3390 is to verify xml docstrings https://devblogs.microsoft.com/dotnet/announcing-f-5/#improved-compiler-analysis-for-library-authors -->
    
    <NeutralLanguage>en</NeutralLanguage>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>    <!--to only have the english resources-->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <RootNamespace>Rhino.Scripting</RootNamespace>
    <AssemblyName>Rhino.Scripting.QrCode</AssemblyName>
    <AssemblyTitle>Rhino.Scripting.QrCode</AssemblyTitle>
    <Product>Rhino.Scripting.QrCode</Product> <!--visible in explorer-->
    <Title>Rhino.Scripting.QrCode</Title>  
    <PackageId>Rhino6.Scripting.QrCode</PackageId>  

    <Version>0.1.0.0</Version>
    <AssemblyVersion>0.1.0.0</AssemblyVersion>
    <FileVersion>0.1.0.0</FileVersion>
    <PackageReleaseNotes>First release</PackageReleaseNotes>
    
    <Authors>GoswinR</Authors>
    <Copyright>Goswin Rothenthal 2021</Copyright>

    <Description>Tools for creating QR codes as vector geometry in Rhino</Description>
        
    <Configuration>Release</Configuration>
    <Platform>x64</Platform>
  

    
  </PropertyGroup>

  <PropertyGroup>  
    <!--https://docs.microsoft.com/en-us/nuget/reference/msbuild-targets#pack-target-->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>      
    <IncludeSymbols>true</IncludeSymbols>
    <!--<SymbolPackageFormat>snupkg</SymbolPackageFormat>-->  <!-- using  snupkg the readme does not pack https://github.com/NuGet/Home/issues/10791 -->    
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>    
    <PackageProjectUrl>https://github.com/goswinr/Rhino.Scripting.QrCode</PackageProjectUrl>
    <RepositoryUrl>https://github.com/goswinr/Rhino.Scripting.QrCode</RepositoryUrl>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <PackageIcon>logo128.png</PackageIcon>
    <PackageReadmeFile>READMEnuget.md</PackageReadmeFile>
    <PackageDescription>Tools for creating QR codes as vector geometry in Rhino</PackageDescription>    
    <PackageTags>rhino3d Rhinoscript RhinoCommon qrcode</PackageTags>    
  </PropertyGroup>

  
  <ItemGroup>
    <PackageReference Include="ZXing.Net" Version="0.16.6" /> <!--for QRcode generation--> 

    <!-- use PrivateAssets="all" these dlls from the output folder  -->
    <PackageReference Include="RhinoCommon" Version="6.0.18016.23451" PrivateAssets="All" />    
  
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="1.1.1" PrivateAssets="All" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />      
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" />   
    <None Include="Doc/READMEnuget.md"  Pack="true" PackagePath="" />
    <None Include="Doc/logo128.png" Pack="true" PackagePath="" /> <!--PackagePath = "" makes the file availabe to nuget pack tool-->


    <Compile Include="QrCode.fs" />

  </ItemGroup> 
</Project>